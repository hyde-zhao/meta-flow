# Input materials (read-only, not tracked)
/.input/*

# Old directories (deprecated)
/.output/*
/.temp/

# Meta-workflow runtime artifacts (external artifact repo; no trailing slash so symlinks are ignored)
/process
/checkpoints/
.meta-workflow/
/.meta-flow-runtime/
/.meta-flow/INSTALL-MANIFEST.yaml

# Internal docs are archived in meta-flow-artifacts; public docs under docs/ stay tracked.
/docs/.meta-flow-docs.yaml
/docs/MODIFICATION-LOG.md
/docs/SKILL-DEVELOPMENT-STANDARD.md
/docs/方案编写补充约定与个人偏好.md
/docs/design
/docs/features

# Build artifacts
build/

# Python bytecode cache
__pycache__/
*.pyc
.venv/
*.egg-info/

# Dependencies
node_modules/
package-lock.json
package.json

# Claude Code / Codex runtime. Root AGENTS.md/CLAUDE.md are generated wrappers;
# delivery/rules/AGENTS.md and delivery/rules/CLAUDE.md are tracked canonical sources.
.agents/
.claude/
.codex/
AGENTS.md
CLAUDE.md

# Delivery package rules are canonical install sources and must be tracked.
# CLAUDE.md is generated from AGENTS.md at install time, not tracked as a source.
!/delivery/rules/AGENTS.md

# Qoder /init local dev guidance (generated, not shared)
/.qoder/rules/
/.qoder/skills/
/.qoder/hooks/
/.qoder/settings.json
/.qoder/settings.local.json
