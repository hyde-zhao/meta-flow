# Input materials (read-only, not tracked)
/.input/*

# Old directories (deprecated)
/.output/*
/.temp/

# Meta-workflow runtime (recommended to gitignore, only delivery/ should be committed)
/process/
/checkpoints/
.meta-workflow/

# Python bytecode cache
__pycache__/
*.pyc
.venv/
*.egg-info/

# Dependencies
node_modules/
package-lock.json
package.json
