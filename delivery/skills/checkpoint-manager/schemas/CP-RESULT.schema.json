{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta Flow CP Result",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint",
    "items",
    "blockers",
    "waivers",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checkpoint": {
      "type": "string",
      "pattern": "^CP[0-8]$"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "story_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cr_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "severity",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "N/A",
              "WAIVED"
            ]
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          },
          "route_on_fail": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rework_same_story",
              "reopen_cp5_design",
              "require_user_decision",
              "create_followup_candidate",
              "escalate_runtime_high_risk",
              "block_release",
              "waive_with_risk_acceptance",
              null
            ]
          },
          "waiver_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array"
    },
    "waivers": {
      "type": "array"
    },
    "read_expansion_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "WAIVED",
        "PASS_WITH_RISK",
        "NEEDS_REWORK",
        "NEEDS_DESIGN_CLARIFICATION"
      ]
    },
    "next_route": {
      "type": [
        "string",
        "null"
      ]
    },
    "checked_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
